#!/usr/bin/env bash
# Pre-commit: project checks, secrets, and gitleaks.
set -uo pipefail
if [ "${SKIP_HOOKS:-}" = "1" ]; then
  echo "  hooks skipped (SKIP_HOOKS=1)"
  exit 0
fi
here=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=checks/lib.sh
. "$here/checks/lib.sh"

status=0
repo_root=$(git rev-parse --show-toplevel)
if [ -x "$repo_root/check" ]; then (cd "$repo_root" && unset $(git rev-parse --local-env-vars) && ./check) || status=1; fi
"$here/checks/secrets.sh" staged || status=1
gitleaks_scan staged || status=1
exit $status
