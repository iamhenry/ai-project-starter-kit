{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode/big-pickle",
  "provider": {
    "ollama-cloud": {
      "models": {
        "kimi-k3": {
          "limit": {
            "context": 262144,
            "output": 131072
          }
        }
      }
    }
  },
  "formatter": false,
  "instructions": [
    "_ai/docs/ETHOS.md"
  ],
  "plugin": [
    "@tarquinen/opencode-dcp@latest", // (https://github.com/Tarquinen/opencode-dynamic-context-pruning)
    "@dietrichgebert/ponytail", // (https://github.com/DietrichGebert/ponytail)
    "opencode-claude-auth@latest", // (https://github.com/griffinmartin/opencode-claude-auth)
    // Disabled: replaced by the reviewed RoderickOxen council below.
    // "opencode-council@https://github.com/iamhenry/opencode-council/archive/40b93cdddfc582fb8bc9aafa3a6d444307578073.tar.gz",
    "opencode-forge@https://github.com/iamhenry/opencode-forge/archive/refs/tags/v0.1.1.tar.gz",
    "opencode-moa",
    "@roderickoxen/opencode-council",
    "open-conclave",
    // Disabled: model routing is currently paused.
    // "opencode-model-router",
    // "oc-codex-multi-auth", // (https://github.com/ndycode/oc-codex-multi-auth)
    // ["@showlotus/opencode-image-vision@latest", { "model": "ollama-cloud/minimax-m3" }], // (https://github.com/showlotus/opencode-image-vision)
  ],
  "compaction": {
    "auto": false
  },
  "experimental": {
    "batch_tool": true, // Enables batch tool for parallel operations
    "disable_paste_summary": true // Disables automatic paste summary feature
  },
  "tui": {
    "scroll_acceleration": {
      "enabled": true
    }
  },
  "keybinds": {
    "model_cycle_favorite": "ctrl+k",
    "model_cycle_favorite_reverse": "ctrl+l",
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "council-researcher": { "model": "xai/grok-4.6" },
    "council-logician": { "model": "openai/gpt-5.6-sol" },
    "council-creative": { "model": "xai/grok-4.6" },
    "council-critic": { "model": "openai/gpt-5.6-sol" },
    "council-synthesizer": { "model": "openai/gpt-6-astra" },
    "conclave-captain": { "model": "openai/gpt-6-astra" },
    "conclave-harper": { "model": "xai/grok-4.6" },
    "conclave-benjamin": { "model": "openai/gpt-5.6-sol" },
    "conclave-lucas": { "model": "ollama-cloud/kimi-k3" }
  }
}
