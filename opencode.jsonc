{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "title": {
      "model": "opencode/big-pickle"
    },
    "explore": {
      "disabled": true
    }
  },
  "providers": {
    "ollama-cloud": {
      "models": {
        "kimi-k3": {
          "limit": {
            "context": 262144,
            "output": 131072
          }
        }
      }
    }
  },
  "formatter": false,
  "instructions": [
    "_ai/docs/ETHOS.md"
  ],
  "plugins": [
    "@tarquinen/opencode-dcp@latest", // OpenCode V2 stable channel
    "@ex-machina/opencode-anthropic-auth@next", // OpenCode V2 prerelease channel
    // "opencode-council@https://github.com/iamhenry/opencode-council/archive/40b93cdddfc582fb8bc9aafa3a6d444307578073.tar.gz",
    // "opencode-forge@https://github.com/iamhenry/opencode-forge/archive/refs/tags/v0.1.1.tar.gz",
    // "oc-codex-multi-auth", // (https://github.com/ndycode/oc-codex-multi-auth)
    // ["@showlotus/opencode-image-vision@latest", { "model": "ollama-cloud/minimax-m3" }], // (https://github.com/showlotus/opencode-image-vision)
  ],
  "compaction": {
    "auto": false
  }
}
