{
 "name": "g4-bind-scalar-lanes",
 "argv": [
  "--once-report"
 ],
 "env": {
  "REPO": "{REPO}",
  "ORCH_THREAD": "thr_dummy1",
  "ORCH_SESSION": "ses_dummy1",
  "VERIFY_DIR": "{REPO}/../bin",
  "LEDGER": "{REPO}/ledger.md",
  "RUN_CARD": "{REPO}/run.md",
  "PROJECT_ID": "proj_dummy1",
  "AUTOMATION_ID": "auto_dummy1"
 },
 "files": {
  "run.md": "status: running\ngoal: dummy goal\n",
  "ledger.md": "- [ ] ISC-1 dummy\n",
  "{HOME}/.bb/plugins/opencode/task-bound.json": "{\"bindings\": 5}",
  "rel.txt": "x\n",
  "lane-a/x": "x\n",
  "lane-a/x\nrel.txt": "x\n",
  "lane-a/.build/out.log": "log\n",
  "lane-b/y\nnothere": "x\n"
 },
 "sqlite": {
  ".local/share/opencode/opencode.db": [
   "CREATE TABLE session_v2(id TEXT, agent TEXT, title TEXT, time_created INTEGER, time_updated INTEGER, parent_id TEXT, directory TEXT, time_idle INTEGER, idle_outcome TEXT)",
   "CREATE TABLE session_message(session_id TEXT,type TEXT,time_updated INTEGER,seq INTEGER,time_created INTEGER,data TEXT)",
   "INSERT INTO session_v2 VALUES ('ses_dummy1','builder','title-dummy',1794528000,1794528000,NULL,'{REPO}',NULL,NULL)",
   "INSERT INTO session_v2 VALUES ('ses_dummy2','builder','title-dummy',1794528000,1794528000,'ses_dummy1','{REPO}',NULL,NULL)",
   "INSERT INTO session_message VALUES ('ses_dummy2','user',1794528000,1,1794528000,'{\"text\": \"PROMISE: kind=build rows=1 result=x-result.md lane=lane-a\"}')",
   "INSERT INTO session_v2 VALUES ('ses_dummy3','builder','title-dummy',1794528000,1794528000,'ses_dummy1','{REPO}',NULL,NULL)",
   "INSERT INTO session_message VALUES ('ses_dummy3','user',1794528000,1,1794528000,'{\"text\": \"PROMISE: kind=code rows=1 result=y-result.md lane=lane-b\"}')"
  ]
 },
 "answers": [
  {
   "match": [
    "uptime"
   ],
   "stdout": " 10:00 up 1 day, 1 user, load averages: 0.10, 0.20, 0.30\n"
  },
  {
   "match": [
    "df"
   ],
   "stdout": "Filesystem 1024-blocks Used Available Capacity Mounted on\n/dev/dummy 100000000 500 99999500 1% /\n"
  },
  {
   "match": [
    "bb",
    "thread",
    "list"
   ],
   "stdout": "[{\"id\":\"thr_dummy2\",\"parentThreadId\":\"thr_dummy1\",\"status\":\"active\",\"visibility\":\"visible\",\"createdAt\":1794528000,\"title\":\"dummy\"}]"
  },
  {
   "match": [
    "bb",
    "thread",
    "show"
   ],
   "stdout": "{\"id\":\"thr_dummy1\",\"status\":\"active\"}"
  },
  {
   "match": [
    "bb",
    "thread",
    "queue"
   ],
   "stdout": "no queued messages"
  },
  {
   "match": [
    "bb",
    "opencode"
   ],
   "stdout": "{}"
  }
 ]
}
